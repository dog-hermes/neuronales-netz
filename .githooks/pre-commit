#!/bin/sh
# Erzeugt vor jedem Commit artifact.html neu aus index.html,
# damit die claude.ai-Version nie veraltet ist.
cd "$(git rev-parse --show-toplevel)" || exit 1
python3 build-artifact.py >/dev/null || { echo "pre-commit: build-artifact.py ist fehlgeschlagen" >&2; exit 1; }
git add artifact.html
